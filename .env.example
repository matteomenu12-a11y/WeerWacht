# Set at build time and at runtime. No secrets in Git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional paid Open-Meteo key, server only.
# OPEN_METEO_API_KEY=

# Optional Web Push settings (a secure cron is a separate setup).
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:contact@example.com
# PUSH_CRON_SECRET=
